{
    "name": "@nk-sh/auth",
    "version": "0.0.1-alpha.0",
    "description": "Reusable authentication runtime and adapters for NK applications",
    "keywords": [
        "authentication",
        "better-auth",
        "nitro",
        "oauth",
        "openid-connect",
        "typescript",
        "vue"
    ],
    "homepage": "https://github.com/nivek-sh/nk-auth#readme",
    "bugs": {
        "url": "https://github.com/nivek-sh/nk-auth/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Kevin Rojas",
        "email": "kevin.rojas.nk@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nivek-sh/nk-auth.git"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./nitro": {
            "types": "./dist/nitro.d.ts",
            "import": "./dist/nitro.js"
        },
        "./password/node": {
            "types": "./dist/password-node.d.ts",
            "import": "./dist/password-node.js"
        },
        "./postgres": {
            "types": "./dist/postgres.d.ts",
            "import": "./dist/postgres.js"
        },
        "./presets/nk": {
            "types": "./dist/preset-nk.d.ts",
            "import": "./dist/preset-nk.js"
        },
        "./resend": {
            "types": "./dist/resend.d.ts",
            "import": "./dist/resend.js"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "import": "./dist/vue.js"
        },
        "./well-known": {
            "types": "./dist/well-known.d.ts",
            "import": "./dist/well-known.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "tsdown",
        "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run validate:package",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --report-unused-disable-directives .",
        "lint:fix": "oxlint --fix .",
        "pack:dry-run": "pnpm pack --dry-run",
        "prepack": "pnpm run check",
        "test": "pnpm run build && pnpm run test:types && node --test tests/*.test.mjs",
        "test:types": "tsc -p type-tests/tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "validate:package": "publint"
    },
    "dependencies": {
        "@better-auth/oauth-provider": "1.6.11",
        "@better-auth/passkey": "1.6.11",
        "better-auth": "1.6.11"
    },
    "devDependencies": {
        "@types/node": "25.9.1",
        "kysely": "0.28.17",
        "kysely-postgres-js": "3.0.0",
        "nitro": "3.0.260522-beta",
        "oxfmt": "0.61.0",
        "oxlint": "1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "postgres": "3.4.9",
        "publint": "0.3.22",
        "resend": "6.12.4",
        "tsdown": "0.22.14",
        "typescript": "6.0.3",
        "vue": "3.5.35",
        "zod": "4.4.3"
    },
    "peerDependencies": {
        "kysely": "^0.28.5",
        "kysely-postgres-js": "^3.0.0",
        "nitro": ">=3.0.0-beta",
        "postgres": "^3.4.9",
        "resend": "^6.12.4",
        "vue": "^3.5.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "kysely": {
            "optional": true
        },
        "kysely-postgres-js": {
            "optional": true
        },
        "nitro": {
            "optional": true
        },
        "postgres": {
            "optional": true
        },
        "resend": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "zod": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.1.1"
}
